# Für Produktion/Pi unbedingt einen langen, zufälligen Wert setzen.
SECRET_KEY=hier-einen-langen-zufaelligen-wert-eintragen

# Relative Pfade werden vom Projektordner aus aufgelöst.
METADATA_DIR=data/videos
USER_DIR=data/users
VIDEO_DIR=uploads/videos
THUMBNAIL_DIR=uploads/thumbnails

# Maximale Größe einer gesamten Upload-Anfrage in MB.
MAX_UPLOAD_MB=2048

# 1 = jeder kann sich selbst als Teilnehmer registrieren, 0 = nur der Administrator legt Konten an.
ALLOW_REGISTRATION=1

# 1 nur hinter Nginx mit den Konfigurationen aus deployment/: Flask prüft die Anmeldung,
# Nginx liefert Videos und Vorschaubilder aus. Lokal ohne Nginx auf 0 lassen.
MEDIA_X_ACCEL=0

# Optional: kompletter Pfad zu ffprobe, falls nicht im PATH.
FFPROBE_PATH=ffprobe

# Optional: kompletter Pfad zu ffmpeg für automatische Vorschaubilder.
FFMPEG_PATH=ffmpeg

# Sicherer Standard: nur dieser PC. Für LAN-Zugriff 0.0.0.0 verwenden.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=0
