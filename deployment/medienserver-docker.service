# Autostart fuer den Medienserver (Docker Compose).
# Installation am Pi:
#   sudo cp /home/pi/medienserver/deployment/medienserver-docker.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now medienserver-docker.service
[Unit]
Description=Medienserver (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/pi/medienserver
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
