# Caddy für den Heimserver (Docker, compose.home.yaml).
# Domain und Upload-Limit kommen aus /opt/medienserver/.env (MEDIENSERVER_DOMAIN, MAX_UPLOAD_MB).
# Caddy holt das Let's-Encrypt-Zertifikat selbst und erneuert es automatisch.
# Dafür müssen TCP 80 und 443 vom Router an 10.0.0.19 weitergeleitet sein.

{
	servers {
		# Kein HTTP/3 (UDP 443), damit am Router nur TCP-Regeln nötig sind.
		protocols h1 h2
	}
}

{$MEDIENSERVER_DOMAIN} {
	request_body {
		max_size {$MAX_UPLOAD_MB:2048}MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}

	handle_path /static/* {
		root * /srv/medienserver-static
		file_server
	}

	handle {
		reverse_proxy app:8000 {
			# Flask prüft die Anmeldung und antwortet mit X-Accel-Redirect (MEDIA_X_ACCEL=1).
			# Caddy liefert die Datei dann selbst aus, inklusive Range-Requests zum Vorspulen.
			# /_protected/videos/<datei> -> /srv/medienserver-data/videos/<datei>
			@accel header X-Accel-Redirect *
			handle_response @accel {
				root * /srv/medienserver-data
				rewrite * {rp.header.X-Accel-Redirect}
				uri strip_prefix /_protected
				method * GET
				file_server
			}
		}
	}
}
